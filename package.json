{
  "name": "dsh-blender-bridge",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: headless Blender modeling with a live 3D viewport",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "python",
    "panel.html",
    "cordis.patch.yml",
    "client.js",
    "docs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "blender",
    "3d",
    "gltf",
    "threejs",
    "modeling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stook-404/dsh-blender-bridge.git"
  },
  "homepage": "https://github.com/Stook-404/dsh-blender-bridge#readme",
  "bugs": {
    "url": "https://github.com/Stook-404/dsh-blender-bridge/issues"
  }
}
